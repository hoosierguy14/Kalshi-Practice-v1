# Kalshi API Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your Kalshi API key ID (from Profile Settings > API Keys)
KALSHI_API_KEY_ID=your-key-id-here

# Path to your RSA private key file (.pem)
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi_private_key.pem

# Environment: "demo" (safe, fake money) or "prod" (real money!)
# ALWAYS start with demo!
KALSHI_ENV=demo
